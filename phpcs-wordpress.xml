<?xml version="1.0"?>
<ruleset name="WooJtlConnector-WordPress">
    <description>WordPress coding standards check for WooCommerce JTL Connector plugin</description>

    <file>src</file>
    <file>includes</file>
    <file>plugins</file>
    <file>uninstall.php</file>
    <file>woo-jtl-connector.php</file>

    <arg name="extensions" value="php"/>
    <arg name="basepath" value="."/>

    <rule ref="WordPress-Extra">
        <exclude name="WordPress.Files.FileName"/>
    </rule>

    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array">
                <element value="woo-jtl-connector"/>
            </property>
        </properties>
    </rule>

    <rule ref="WordPress.NamingConventions.PrefixAllGlobals">
        <properties>
            <property name="prefixes" type="array">
                <element value="JtlWooCommerceConnector"/>
                <element value="jtl_connector"/>
                <element value="woo_jtl"/>
            </property>
        </properties>
    </rule>

    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/tests/*</exclude-pattern>
    <exclude-pattern>*/stubs/*</exclude-pattern>
    <exclude-pattern>*/Wpml/*</exclude-pattern>
</ruleset>
