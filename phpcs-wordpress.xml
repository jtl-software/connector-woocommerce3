<?xml version="1.0"?>
<ruleset name="WooJtlConnector-PluginCheck">
    <description>WordPress Plugin Check relevant sniffs for local pre-check</description>

    <file>src</file>
    <file>includes</file>
    <file>plugins</file>
    <file>uninstall.php</file>
    <file>woo-jtl-connector.php</file>

    <arg name="extensions" value="php"/>
    <arg name="basepath" value="."/>

    <rule ref="WordPress.DB.DirectDatabaseQuery"/>

    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array">
                <element value="woo-jtl-connector"/>
            </property>
        </properties>
    </rule>

    <rule ref="WordPress.NamingConventions.PrefixAllGlobals">
        <properties>
            <property name="prefixes" type="array">
                <element value="JtlWooCommerceConnector"/>
                <element value="JtlConnector"/>
                <element value="jtl_connector"/>
                <element value="woo_jtl"/>
                <element value="JTLWCC"/>
                <element value="jtlwcc"/>
            </property>
        </properties>
    </rule>

    <rule ref="WordPress.Security.EscapeOutput"/>
    <rule ref="WordPress.Security.NonceVerification"/>
    <rule ref="WordPress.Security.ValidatedSanitizedInput"/>

    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/tests/*</exclude-pattern>
    <exclude-pattern>*/stubs/*</exclude-pattern>
    <exclude-pattern>*/Wpml/*</exclude-pattern>
</ruleset>
