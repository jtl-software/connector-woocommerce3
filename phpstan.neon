parameters:
    bootstrapFiles:
        - vendor/php-stubs/woocommerce-stubs/woocommerce-stubs.php
    scanDirectories:
        - ./stubs
    excludePaths:
        analyse:
            - '*/vendor/*'
            - '*/tests/*'
            - './var/*'
    ignoreErrors:
        - '#Constant WC_DELIMITER not found.#'
        -
            message: '#Binary operation "\."\s+between .+ and array\|string results in an error#'
            path: includes/JtlConnectorAdmin.php
            count: 7
        -
            message: '#Strict comparison using === between non-empty-string and false will always evaluate to false#'
            path: woo-jtl-connector.php
            count: 1
        -
            # Db::query/queryOne/queryList are generic SQL runners; $query is built by SqlTrait
            # methods that use sprintf() — a dynamic string, never a literal-string. Using
            # $wpdb->prepare($query) satisfies the WP plugin-check PHPCS sniff while PHPStan's
            # WordPress stubs require literal-string. This is an architectural boundary;
            # callers are responsible for safe query construction via the SqlTrait layer.
            message: '#Parameter \#1 \$query of method wpdb::prepare\(\) expects literal-string, string given\.#'
            path: src/Utilities/Db.php
            count: 3